# ---------------------------------------------------------------------------
# Minna — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database: Neon (Postgres) --------------------------------------------
# Neon connection string (pooled). Used by Drizzle (src/db) and drizzle-kit.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/minna?sslmode=require"

# --- Cache: Redis ----------------------------------------------------------
# Redis connection URL. If unset, the cache layer becomes a no-op (dev only).
REDIS_URL="redis://default:password@host:6379"

# --- Data source: embedded Consumet (@consumet/extensions) -----------------
# Anime data is fetched in-process via the embedded AniList provider — no
# external Consumet server is required. Metadata comes from AniList's GraphQL
# API; episode lists and playable streams come from a scraping sub-provider.
# These sources are volatile: if the default is down, switch here with no code
# change. One of: animeunity (default), animekai, animepahe, hianime,
# kickassanime, animesama, animesaturn. As of mid-2026 only animeunity resolves
# episodes AND playable sources end-to-end (the English providers' domains died
# or their markup moved in this library version). Note: animeunity is an Italian
# catalogue, so audio/subtitles may be Italian. Metadata is always from AniList.
ANIME_PROVIDER="animeunity"

# --- Authentication: Google OAuth (only auth method) -----------------------
# From Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Auth.js / NextAuth session config (AUTH-01/04).
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
# Canonical URL of the app (http://localhost:3000 in dev).
NEXTAUTH_URL="http://localhost:3000"

# --- Media: Cloudinary background uploads ----------------------------------
# Signed server-side upload and animated WebP derivative for admin backgrounds.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional Cloudinary folder for originals. The app stores only the WebP URL.
CLOUDINARY_BACKGROUND_FOLDER="minna/bg/admin"

# --- Misc ------------------------------------------------------------------
# Public site URL used for metadata / sitemap / Open Graph (PERF-01).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: endpoint that receives Core Web Vitals beacons (PERF-03). When set,
# LCP/CLS/INP/FCP/TTFB metrics are POSTed via navigator.sendBeacon. Unset in dev.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=""
NEXT_TELEMETRY_DISABLED="1"

# --- Ad units (HOME-08) ----------------------------------------------------
# One unit PER PLACEMENT, so each slot reports its own numbers instead of being
# merged into a single dashboard row. Unset placements fall back to the
# original shared Adsterra key, except `WATCH_SECONDARY`, which stays dark
# until it has a unit of its own.
#
# Two value forms:
#   "<key>" / "<key>@https://loader-host"  -> an Adsterra unit. The host is
#       only needed when the unit's GET CODE snippet names one other than
#       https://www.highrevenueformat.com (a key only fills on its own host).
#   "hilltop:<loader url>"                 -> a HilltopAds unit. The whole URL
#       is the unit identity and its domain rotates, hence the env.
#
# The *_MOBILE variants are 300x250 units served below the `md` breakpoint —
# a 728x90 scaled into a phone viewport is ~44px tall and barely viewable.
# Adsterra allows only one unit per size per website, so pointing a placement
# at a second network is also how that placement gets numbers of its own.
NEXT_PUBLIC_AD_HOME=""
NEXT_PUBLIC_AD_HOME_MOBILE=""
NEXT_PUBLIC_AD_ANIME=""
NEXT_PUBLIC_AD_ANIME_MOBILE=""
NEXT_PUBLIC_AD_EPISODES=""
NEXT_PUBLIC_AD_EPISODES_MOBILE=""
NEXT_PUBLIC_AD_WATCH=""
NEXT_PUBLIC_AD_WATCH_MOBILE=""
NEXT_PUBLIC_AD_WATCH_SECONDARY=""
NEXT_PUBLIC_AD_WATCH_SECONDARY_MOBILE=""
